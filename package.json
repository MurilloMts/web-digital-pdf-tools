{
  "name": "web-digital-pdf-tools",
  "version": "1.0.4",
  "description": "Web Digital · PDF Tools — combine documentos Office/PDF e edite PDFs. Desenvolvido por Murillo Matos",
  "main": "main.js",
  "author": {
    "name": "Murillo Matos",
    "url": "https://webdigital.app"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "gen:icons": "electron tools/gen-icons.js",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "app.webdigital.pdftools",
    "productName": "Web Digital - PDF Tools",
    "copyright": "Copyright © 2026 Murillo Matos - Web Digital",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "WebDigital-PDF-Tools-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!tools/**",
      "!.claude/**",
      "!.github/**",
      "!*.code-workspace"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MurilloMts",
        "repo": "web-digital-pdf-tools",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "WebDigital-PDF-Tools-Portatil-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
